# Supabase Configuration
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here

# Edge Function Secrets (configure in Supabase Dashboard -> Settings -> Edge Functions)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
# BCRYPT_ROUNDS=12 (optional, defaults to 12 if not set)

# Note: Never expose service_role key or other secrets in client-side code
# These are only needed for Edge Functions and should be set in Supabase dashboard