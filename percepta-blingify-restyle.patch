+/* --------------------------------------------------------------------------
+   Logo
+   -------------------------------------------------------------------------- */
+.logo-text {
+  font-family: var(--font-display);
+  font-size: 1.65rem;
+  font-weight: 700;
+  letter-spacing: 0.02em;
+  color: var(--ink);
+}
+.logo-accent { color: var(--grape); }
+
+/* --------------------------------------------------------------------------
+   Buttons: one recipe, applied to every primary action in the app
+   -------------------------------------------------------------------------- */
+.btn-cta, .btn-primary, .btn-submit, .btn-verify, .btn-reset, .btn-upload,
+.btn-secondary, .btn-view, .btn-view-all, .btn-logout {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  gap: 0.5rem;
+  font-family: var(--font-display);
+  font-weight: 600;
+  font-size: 1.05rem;
+  line-height: 1.2;
+  padding: 0.85rem 1.6rem;
+  color: var(--ink);
+  background: var(--bubblegum);
+  border: 2.5px solid var(--ink);
+  border-radius: var(--r-sm);
+  box-shadow: var(--shadow-md);
+  cursor: pointer;
+  transition: transform 0.12s ease, box-shadow 0.12s ease, background-color 0.12s ease;
+}
+
+.btn-cta:hover, .btn-primary:hover, .btn-submit:hover, .btn-verify:hover,
+.btn-reset:hover, .btn-upload:hover {
+  background: var(--bubblegum-deep);
+  transform: translate(-1px, -1px);
+  box-shadow: 6px 6px 0 var(--ink);
+}
+
+.btn-secondary { background: var(--white); }
+.btn-secondary:hover, .btn-view-all:hover { background: var(--butter); transform: translate(-1px, -1px); box-shadow: 6px 6px 0 var(--ink); }
+
+.btn-view { background: var(--grape); color: var(--white); font-size: 0.95rem; padding: 0.55rem 1.1rem; box-shadow: var(--shadow-sm); }
+.btn-view:hover { background: #5B33C4; transform: translate(-1px, -1px); box-shadow: 4px 4px 0 var(--ink); }
+
+.btn-view-all { background: var(--white); width: 100%; box-shadow: var(--shadow-sm); font-size: 0.95rem; }
+
+.btn-logout { background: var(--white); color: var(--danger); width: 100%; padding: 0.65rem; font-size: 0.95rem; box-shadow: var(--shadow-sm); }
+.btn-logout:hover { background: #FFE3E0; transform: translate(-1px, -1px); box-shadow: 4px 4px 0 var(--ink); }
+
+.btn-cta:active, .btn-primary:active, .btn-submit:active, .btn-verify:active,
+.btn-reset:active, .btn-upload:active, .btn-secondary:active, .btn-view:active,
+.btn-view-all:active, .btn-logout:active {
+  transform: translate(3px, 3px);
+  box-shadow: 0 0 0 var(--ink);
+}
+
+.btn-submit, .btn-verify, .btn-reset { width: 100%; margin-top: 0.25rem; }
+.btn-cta, .btn-secondary { font-size: 1.15rem; padding: 1rem 2rem; }
+
+button:disabled, .btn-submit:disabled, .btn-verify:disabled, .btn-reset:disabled {
+  opacity: 0.6;
+  cursor: not-allowed;
+  transform: none;
+  box-shadow: var(--shadow-sm);
+}
+
+/* --------------------------------------------------------------------------
+   Forms
+   -------------------------------------------------------------------------- */
+.form-group { display: flex; flex-direction: column; gap: 0.4rem; }
+
+.form-group label {
+  font-weight: 700;
+  font-size: 0.95rem;
+  color: var(--ink);
+}
+
+.form-group input,
+.otp-input {
+  padding: 0.8rem 1rem;
+  font: inherit;
+  font-size: 1rem;
+  color: var(--ink);
+  background: var(--white);
+  border: 2.5px solid var(--ink);
+  border-radius: var(--r-sm);
+  transition: box-shadow 0.12s ease, background-color 0.12s ease;
+}
+
+.form-group input::placeholder { color: #8A7FA6; }
+
+.form-group input:focus,
+.otp-input:focus {
+  outline: 3px solid transparent;           /* keeps a visible ring in forced-colors mode */
+  background: #FBF8FF;
+  box-shadow: 0 0 0 4px var(--lavender), 3px 3px 0 var(--grape);
+}
+
+.form-error {
+  padding: 0.75rem 1rem;
+  margin-bottom: 1rem;
+  font-size: 0.95rem;
+  font-weight: 500;
+  color: #7A140F;
+  background: #FFE3E0;
+  border: 2px solid var(--danger);
+  border-radius: var(--r-sm);
 }
 
-/* App shell background */
-.app-bg {
-  background: linear-gradient(180deg, #0e1450 0%, #12185a 100%);
+/* --------------------------------------------------------------------------
+   Auth-style page shells (login, register, verify, reset)
+   -------------------------------------------------------------------------- */
+.auth-page, .verify-page, .reset-page {
   min-height: 100vh;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  padding: 2rem;
+}
+
+.auth-card, .verify-card, .reset-card {
+  background: var(--white);
+  border: 2.5px solid var(--ink);
+  border-radius: var(--r-lg);
+  padding: 2.75rem;
+  box-shadow: var(--shadow-lg);
+}
+
+.auth-title, .verify-title, .reset-title {
+  font-size: 2rem;
+  font-weight: 700;
+  line-height: 1.15;
+  text-align: center;
+  margin: 0 0 0.5rem;
+  color: var(--ink);
+}
+
+.auth-subtitle, .verify-subtitle, .reset-subtitle {
+  text-align: center;
+  color: var(--ink-soft);
+  margin: 0 0 2rem;
+}
+
+.auth-switch, .back-link, .resend-text {
+  text-align: center;
+  color: var(--ink-soft);
+  font-size: 0.95rem;
+  margin: 1.5rem 0 0;
+}
+
+.auth-link, .link, .forgot-link, .resend-btn {
+  color: var(--grape);
+  font-weight: 700;
+  text-decoration: underline;
+  text-decoration-thickness: 2px;
+  text-underline-offset: 3px;
+  text-decoration-color: var(--lavender);
+  transition: text-decoration-color 0.12s ease;
+}
+.auth-link:hover, .link:hover, .forgot-link:hover, .resend-btn:hover { text-decoration-color: var(--grape); }
+.resend-btn { background: none; border: none; padding: 0; font-size: inherit; }
+
+@media (max-width: 640px) {
+  .auth-page, .verify-page, .reset-page { padding: 1rem; }
+  .auth-card, .verify-card, .reset-card { padding: 1.75rem 1.25rem; }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  *, *::before, *::after {
+    animation: none !important;
+    transition: none !important;
+  }
 }
